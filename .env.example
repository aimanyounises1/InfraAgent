# =============================================================================
# InfraAgent -- Environment Variables
# Copy this file to .env and fill in your values.
# All variables are prefixed with INFRA_AGENT_ in the app config.
#
# The system auto-detects available infrastructure at startup.
# Only set overrides when you need to force specific behavior.
# =============================================================================

# --- LLM Provider (choose one) ---
INFRA_AGENT_LLM_PROVIDER=ollama        # ollama, nvidia, claude, openai, gemini

# Ollama (local / air-gapped HPC -- default)
INFRA_AGENT_OLLAMA_BASE_URL=http://localhost:11434
INFRA_AGENT_OLLAMA_MODEL=nemotron-3-nano

# NVIDIA NIM (recommended for on-prem HPC)
# INFRA_AGENT_NVIDIA_API_KEY=nvapi-...
# INFRA_AGENT_NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Claude (Anthropic)
# INFRA_AGENT_ANTHROPIC_API_KEY=sk-ant-...
# INFRA_AGENT_CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI
# INFRA_AGENT_OPENAI_API_KEY=sk-...
# INFRA_AGENT_OPENAI_MODEL=gpt-4o

# Google Gemini
# INFRA_AGENT_GEMINI_API_KEY=...
# INFRA_AGENT_GEMINI_MODEL=gemini-2.0-flash

# --- GPU Monitoring ---
# Auto-detected: pynvml (NVIDIA) -> psutil (Apple Silicon) -> none
# No mock flag needed -- the system adapts to available hardware.
# INFRA_AGENT_DCGM_HOST=localhost
# INFRA_AGENT_DCGM_PORT=5555

# --- Slurm HPC Scheduler ---
# Auto-detected at the tool layer. Returns errors when unavailable.
# INFRA_AGENT_SLURM_REST_URL=http://localhost:6820
# INFRA_AGENT_SLURM_JWT_TOKEN=
# INFRA_AGENT_SLURM_CLUSTER_NAME=

# --- Kubernetes ---
# Auto-detected at the tool layer. Returns errors when unavailable.
# KUBECONFIG=~/.kube/config

# --- Jira (optional -- set URL and token to enable) ---
# INFRA_AGENT_JIRA_URL=https://yourcompany.atlassian.net
# INFRA_AGENT_JIRA_TOKEN=
# INFRA_AGENT_JIRA_USER=

# --- Grafana (optional -- set URL and token to enable) ---
# INFRA_AGENT_GRAFANA_URL=http://localhost:3000
# INFRA_AGENT_GRAFANA_TOKEN=

# --- PagerDuty (optional -- set token to enable) ---
# INFRA_AGENT_PAGERDUTY_TOKEN=

# --- API Settings ---
# INFRA_AGENT_API_HOST=0.0.0.0
# INFRA_AGENT_API_PORT=8000
# INFRA_AGENT_CORS_ORIGINS=["http://localhost:3000"]

# =============================================================================
# InfraAgent — Environment Variables
# Copy this file to .env and fill in your values.
# All variables are prefixed with INFRA_AGENT_ in the app config.
# =============================================================================

# Required
INFRA_AGENT_ANTHROPIC_API_KEY=sk-ant-...

# Kubernetes (optional — auto-detects kubeconfig)
KUBECONFIG=~/.kube/config

# GPU Monitoring
INFRA_AGENT_MOCK_GPU=true  # Set to false if real NVIDIA GPUs available

# Jira (optional — uses mock if not set)
INFRA_AGENT_MOCK_JIRA=true
INFRA_AGENT_JIRA_URL=https://yourcompany.atlassian.net
INFRA_AGENT_JIRA_TOKEN=your-jira-api-token
INFRA_AGENT_JIRA_USER=your-email@company.com

# Grafana (optional — uses mock if not set)
INFRA_AGENT_MOCK_GRAFANA=true
INFRA_AGENT_GRAFANA_URL=http://localhost:3000
INFRA_AGENT_GRAFANA_TOKEN=your-grafana-api-key

# PagerDuty (optional — uses mock if not set)
INFRA_AGENT_MOCK_PAGERDUTY=true
INFRA_AGENT_PAGERDUTY_TOKEN=your-pagerduty-api-key
